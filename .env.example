# Environment Configuration Template for Weather Intelligence Platform

# Project Metadata
PROJECT_NAME="Weather Intelligence Platform"
DEVELOPER="Aanchal Singh"
ORGANIZATION="PM Accelerator"

# PostgreSQL Connection String
# Connects via psycopg 3 driver to local or hosted PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/weather_db

# Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT=10

# External API Configuration
# Optional: YouTube Data API v3 key (genuine fallback search URL provided if blank)
YOUTUBE_API_KEY=

# HTTP Request Timeout (seconds)
REQUEST_TIMEOUT=15
